    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.5.0",
    "recharts": "^3.10.1",
    "shadcn": "^4.22.1",
    "socket.io-client": "^4.8.4",
