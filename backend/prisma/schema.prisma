generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

enum SellerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductType {
  FIXED_PRICE
  AUCTION
}

enum ProductStatus {
  DRAFT
  PENDING_MODERATION
  ACTIVE
  REJECTED
  SOLD_OUT
  ARCHIVED
}

enum AuctionStatus {
  ACTIVE
  AWAITING_CHECKOUT
  SOLD
  UNSOLD
  CANCELLED
}

enum OrderStatus {
  NEW
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  PARTIALLY_COMPLETED
  COMPLETED
  CANCELLED
}

enum SellerOrderStatus {
  NEW
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum LedgerEntryType {
  SALE
  COMMISSION
  REFUND
  COMMISSION_REVERSAL
  CANCELLATION
  COMMISSION_CANCELLATION
  PAYOUT
}

enum DisputeStatus {
  OPEN
  RESOLVED_FOR_BUYER
  RESOLVED_FOR_SELLER
  CLOSED
}

enum IdempotencyScope {
  CHECKOUT
  BID
  REFUND
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String?  @map("password_hash")
  googleId     String?  @unique @map("google_id")
  name         String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens        RefreshToken[]
  sellerApplications   SellerApplication[] @relation("applicant")
  reviewedApplications SellerApplication[] @relation("reviewer")
  seller               Seller?
  cart                 Cart?
  orders               Order[]
  bids                 Bid[]
  wonAuctions          Auction[]           @relation("winner")
  leadingAuctions      Auction[]           @relation("leader")
  reviews              Review[]
  openedDisputes       Dispute[]           @relation("openedBy")
  resolvedDisputes     Dispute[]           @relation("resolvedBy")
  notifications        Notification[]
  idempotencyKeys      IdempotencyKey[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model SellerApplication {
  id           String                  @id @default(uuid(7)) @db.Uuid
  userId       String                  @map("user_id") @db.Uuid
  storeName    String                  @map("store_name")
  description  String?
  status       SellerApplicationStatus @default(PENDING)
  reviewedById String?                 @map("reviewed_by_id") @db.Uuid
  reviewNote   String?                 @map("review_note")
  reviewedAt   DateTime?               @map("reviewed_at") @db.Timestamptz(3)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User  @relation("applicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("reviewer", fields: [reviewedById], references: [id])

  @@index([status, createdAt])
  @@index([userId])
  @@map("seller_applications")
}

model Seller {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  storeName   String   @unique @map("store_name")
  description String?
  ratingAvg   Decimal  @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount Int      @default(0) @map("rating_count")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  products     Product[]
  sellerOrders SellerOrder[]
  ledger       LedgerEntry[]
  dailyStats   SalesDaily[]

  @@map("sellers")
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String   @unique
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Category?  @relation("tree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("tree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id             String        @id @default(uuid(7)) @db.Uuid
  sellerId       String        @map("seller_id") @db.Uuid
  categoryId     String        @map("category_id") @db.Uuid
  title          String
  description    String
  type           ProductType   @default(FIXED_PRICE)
  status         ProductStatus @default(PENDING_MODERATION)
  priceMinor     Int           @map("price_minor")
  stock          Int           @default(0)
  imageUrls      String[]      @default([]) @map("image_urls")
  ratingAvg      Decimal       @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount    Int           @default(0) @map("rating_count")
  version        Int           @default(0)
  moderationNote String?       @map("moderation_note")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  seller     Seller       @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  auction    Auction?
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]
  salesDaily SalesDaily[]

  @@index([sellerId, status])
  @@index([categoryId, status])
  @@index([status, createdAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_title_trgm_idx")
  @@map("products")
}

model Auction {
  id                String        @id @default(uuid(7)) @db.Uuid
  productId         String        @unique @map("product_id") @db.Uuid
  startPriceMinor   Int           @map("start_price_minor")
  bidStepMinor      Int           @map("bid_step_minor")
  currentPriceMinor Int?          @map("current_price_minor")
  leaderId          String?       @map("leader_id") @db.Uuid
  bidCount          Int           @default(0) @map("bid_count")
  startsAt          DateTime      @default(now()) @map("starts_at") @db.Timestamptz(3)
  endsAt            DateTime      @map("ends_at") @db.Timestamptz(3)
  status            AuctionStatus @default(ACTIVE)
  winnerId          String?       @map("winner_id") @db.Uuid
  checkoutDeadline  DateTime?     @map("checkout_deadline") @db.Timestamptz(3)
  version           Int           @default(0)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  leader  User?   @relation("leader", fields: [leaderId], references: [id])
  winner  User?   @relation("winner", fields: [winnerId], references: [id])
  bids    Bid[]

  @@index([status, endsAt])
  @@index([status, checkoutDeadline])
  @@map("auctions")
}

model Bid {
  id          String   @id @default(uuid(7)) @db.Uuid
  auctionId   String   @map("auction_id") @db.Uuid
  bidderId    String   @map("bidder_id") @db.Uuid
  amountMinor Int      @map("amount_minor")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  bidder  User    @relation(fields: [bidderId], references: [id])

  @@index([auctionId, amountMinor(sort: Desc)])
  @@index([bidderId, createdAt])
  @@map("bids")
}

model Cart {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id              String        @id @default(uuid(7)) @db.Uuid
  buyerId         String        @map("buyer_id") @db.Uuid
  status          OrderStatus   @default(NEW)
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  totalMinor      BigInt        @map("total_minor")
  commissionMinor BigInt        @map("commission_minor")
  refundedMinor   BigInt        @default(0) @map("refunded_minor")
  version         Int           @default(0)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  buyer        User          @relation(fields: [buyerId], references: [id])
  sellerOrders SellerOrder[]
  payment      Payment?

  @@index([buyerId, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model SellerOrder {
  id                String            @id @default(uuid(7)) @db.Uuid
  orderId           String            @map("order_id") @db.Uuid
  sellerId          String            @map("seller_id") @db.Uuid
  status            SellerOrderStatus @default(NEW)
  subtotalMinor     BigInt            @map("subtotal_minor")
  commissionRateBps Int               @map("commission_rate_bps")
  commissionMinor   BigInt            @map("commission_minor")
  refundedMinor     BigInt            @default(0) @map("refunded_minor")
  cancelReason      String?           @map("cancel_reason")
  version           Int               @default(0)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  order    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller   Seller        @relation(fields: [sellerId], references: [id])
  items    OrderItem[]
  refunds  Refund[]
  ledger   LedgerEntry[]
  disputes Dispute[]

  @@unique([orderId, sellerId])
  @@index([sellerId, status, createdAt])
  @@index([status, createdAt])
  @@map("seller_orders")
}

model OrderItem {
  id               String   @id @default(uuid(7)) @db.Uuid
  sellerOrderId    String   @map("seller_order_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  titleSnapshot    String   @map("title_snapshot")
  unitPriceMinor   Int      @map("unit_price_minor")
  quantity         Int
  refundedQuantity Int      @default(0) @map("refunded_quantity")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
  refunds     Refund[]
  review      Review?

  @@index([sellerOrderId])
  @@index([productId, createdAt])
  @@map("order_items")
}

model Payment {
  id          String        @id @default(uuid(7)) @db.Uuid
  orderId     String        @unique @map("order_id") @db.Uuid
  status      PaymentStatus @default(PENDING)
  amountMinor BigInt        @map("amount_minor")
  providerRef String?       @map("provider_ref")
  failReason  String?       @map("fail_reason")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Refund {
  id                      String   @id @default(uuid(7)) @db.Uuid
  sellerOrderId           String   @map("seller_order_id") @db.Uuid
  orderItemId             String   @map("order_item_id") @db.Uuid
  quantity                Int
  amountMinor             BigInt   @map("amount_minor")
  commissionReversalMinor BigInt   @map("commission_reversal_minor")
  reason                  String?
  createdById             String   @map("created_by_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sellerOrder SellerOrder   @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id])
  ledger      LedgerEntry[]

  @@index([sellerOrderId])
  @@index([createdAt])
  @@map("refunds")
}

model LedgerEntry {
  id            String          @id @default(uuid(7)) @db.Uuid
  sellerId      String          @map("seller_id") @db.Uuid
  sellerOrderId String?         @map("seller_order_id") @db.Uuid
  refundId      String?         @map("refund_id") @db.Uuid
  type          LedgerEntryType
  amountMinor   BigInt          @map("amount_minor")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  seller      Seller       @relation(fields: [sellerId], references: [id])
  sellerOrder SellerOrder? @relation(fields: [sellerOrderId], references: [id])
  refund      Refund?      @relation(fields: [refundId], references: [id])

  @@index([sellerId, createdAt])
  @@index([type, createdAt])
  @@index([sellerOrderId])
  @@index([refundId])
  @@map("ledger_entries")
}

model Review {
  id          String   @id @default(uuid(7)) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  authorId    String   @map("author_id") @db.Uuid
  orderItemId String   @unique @map("order_item_id") @db.Uuid
  rating      Int
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@unique([productId, authorId])
  @@index([productId, createdAt])
  @@map("reviews")
}

model Dispute {
  id             String        @id @default(uuid(7)) @db.Uuid
  sellerOrderId  String        @map("seller_order_id") @db.Uuid
  openedById     String        @map("opened_by_id") @db.Uuid
  reason         String
  status         DisputeStatus @default(OPEN)
  resolutionNote String?       @map("resolution_note")
  resolvedById   String?       @map("resolved_by_id") @db.Uuid
  resolvedAt     DateTime?     @map("resolved_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  openedBy    User        @relation("openedBy", fields: [openedById], references: [id])
  resolvedBy  User?       @relation("resolvedBy", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
  @@index([sellerOrderId])
  @@map("disputes")
}

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  payload   Json
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  type          String
  payload       Json
  correlationId String?   @map("correlation_id")
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, eventId])
  @@map("processed_events")
}

model IdempotencyKey {
  id             String           @id @default(uuid(7)) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  scope          IdempotencyScope
  key            String
  requestHash    String           @map("request_hash")
  responseStatus Int?             @map("response_status")
  responseBody   Json?            @map("response_body")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model SalesDaily {
  day             DateTime @db.Date
  sellerId        String   @map("seller_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  ordersCount     Int      @default(0) @map("orders_count")
  unitsSold       Int      @default(0) @map("units_sold")
  grossMinor      BigInt   @default(0) @map("gross_minor")
  commissionMinor BigInt   @default(0) @map("commission_minor")
  refundedMinor   BigInt   @default(0) @map("refunded_minor")

  seller  Seller  @relation(fields: [sellerId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@id([day, sellerId, productId])
  @@index([sellerId, day])
  @@index([productId, day])
  @@map("sales_daily")
}
