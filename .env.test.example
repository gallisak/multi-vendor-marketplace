NODE_ENV=test
API_PORT=3099
LOG_LEVEL=silent
LOG_PRETTY=false
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_PER_MINUTE=10000
LOGIN_IP_RATE_LIMIT_PER_MINUTE=1000

DATABASE_URL=postgresql://mvm:mvm@localhost:5433/mvm_test
REDIS_URL=redis://localhost:6379/1
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key-change-me
MEILI_INDEX_PREFIX=test_
SEARCH_TIMEOUT_MS=1500

WORKER_PORT=3098
OUTBOX_RELAY_INTERVAL_MS=100
OUTBOX_BATCH_SIZE=100

JWT_ACCESS_SECRET=test-access-secret-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=test-refresh-secret-0123456789
JWT_REFRESH_TTL=7d
REFRESH_ROTATION_GRACE_SECONDS=10

GOOGLE_CLIENT_ID=e2e-client.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=e2e-google-secret
GOOGLE_CALLBACK_URL=http://localhost:3099/api/auth/google/callback
CATALOG_CACHE_TTL_SECONDS=60
CATALOG_LIST_CACHE_TTL_SECONDS=10

PLATFORM_COMMISSION_PERCENT=10
PAYMENT_MOCK_DECLINE_ABOVE_MINOR=1000000
