PAYMENT_EXPIRY_INTERVAL_MS=200
PAYOUT_HOLD=1h
PAYOUT_INTERVAL_MS=200

AUCTION_CHECKOUT_WINDOW=1h
AUCTION_SWEEP_INTERVAL_MS=200
BID_RATE_LIMIT_PER_MINUTE=10000
REALTIME_AUTH_RECHECK_MS=200
